# Build products: objects, test binaries, the seed tool, and the bundle.
build/
/*.app/

# The development sandbox: `make run`, `make seed`, `make test` and
# `make ui-check` keep all their data here (dev/data, dev/test-data,
# dev/snapshots), never in the per-user data directory.
dev/

# Any .bak — a schema migration leaves <db>.pre-v<N>.bak beside the
# database, and no editor or script backup belongs in this repo either.
*.bak

.DS_Store

# Agent worktrees live INSIDE the repo, so `git add` turns one into a
# phantom submodule.  Ignore the parent so it cannot happen.
.claude/worktrees/

# A Google OAuth client the retired Google sync used: per-developer files
# that may still sit in a checkout, never to be committed.
client_credentials.mk
client_secret*.json
