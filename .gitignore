build/
dist/

# The compiled binary: a build artifact, and it BAKES the Google OAuth
# client id/secret in from client_credentials.mk — committing it
# publishes them (GitHub push protection caught exactly that).
tasks
# `make app` builds into dist/ (ignored above); this only guards a stray
# bundle left at the repo root.
Tasks.app/

# The LIVE config: per-machine values, and it holds the OAuth refresh
# token.  Only tasks.ini.defaults belongs in git (see the "Config"
# convention in CLAUDE.md).  Anchored so it cannot match the defaults.
/tasks.ini

# Any .bak — a schema migration leaves <db>.pre-v<N>.bak beside the
# database, and no editor or script backup belongs in this repo either.
*.bak

client_credentials.mk
.DS_Store

# Agent worktrees live INSIDE the repo, so `git add` turns one into a
# phantom submodule (a mode-160000 gitlink, no .gitmodules) that GitHub
# renders as a broken folder.  Ignore the parent so it cannot happen
# again — this does not disturb a live worktree checked out there.
.claude/worktrees/

# clangd compilation database — machine-specific include paths
# (regenerated by `make`).
compile_commands.json
.cache/

# The Google OAuth client file (downloaded from the Cloud console) —
# credentials must never be committed.
client_secret*.json
