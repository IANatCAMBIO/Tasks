[Icon Theme]
Name=Hicolor
Comment=Tasks bundled icons: elementary pan arrows (scalable, for crisp
 expanders on HiDPI displays) and the app logo as apps/tasks, the GTK4
 default window icon
Directories=scalable/actions,512x512/apps

[scalable/actions]
Context=Actions
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[512x512/apps]
Context=Applications
Size=512
Type=Threshold
