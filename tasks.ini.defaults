# Tasks — default settings, copied into the live tasks.ini on
# first launch.  The live ini is rewritten by the app and is gitignored.
#
# The group name below is part of the file format: the app reads only
# [tasks].
[tasks]
# Move the menu into the native macOS menu bar (1|0; needs a build with
# gtk-mac-integration-gtk3 — see Settings → Appearance).
native_menubar=0
# Render task titles in bold in the task list (1|0, default 0; Settings → Appearance).
bold_task_titles=0
# Show completed tasks in the task list (1|0, default 1; toolbar toggle).
show_completed=1
# Sidebar visibility (1|0, default 0; the toolbar Sidebar toggle and
# View → Show Sidebar, which reads "Hide Sidebar" once it is up — every
# View item is named for the action a click performs).
sidebar_visible=0
# Compact controls (1|0, default 0; View → Compact Controls, which reads
# "Full Controls" while it is on): hides the top
# toolbar and floats New/Delete Task 20 px in from the bottom-right of
# the task area instead.  It leaves the sidebar alone — that stays under
# sidebar_visible above, in compact mode just the same.
compact_layout=0
# Let the Due Today view also list everything already past due
# (1|0, default 0; Settings → Appearance).
due_today_show_overdue=0
# Recurring tasks (Settings → Recurring Tasks).  A repeat is set per
# task, in the editor's Advanced section: how often (hourly, daily,
# weekly, every 2 weeks, monthly, or a custom "every N minutes/hours/
# days/weeks/months/years"), the time of day the dated ones land on
# (08:00 by default), and how long BEFORE each repeat a COMPLETED task
# is put back to New and re-dated (five days by default, shortened
# automatically when it would not fit inside the repeat itself).
# Those live on the task row, not here.
#
# There are NO recurrence keys here and no Settings section for it.  A
# schedule set on a task is the request to act on it, and the pass arms
# itself for the earliest occurrence rather than waking on a timer — so
# with nothing recurring it costs one query at launch and no timer at
# all, and there is nothing a switch would save.  Occurrences that came
# round while Tasks was closed are applied at launch.
# Kanban View (1|0, default 0; View → Kanban View): show the selected
# view's tasks as a three-lane board (New / In Progress / Done) instead
# of a list, with cards you drag between lanes to change their status —
# and up and down within a lane to order them.  The card order is stored
# per view in kanban_order_list_<id>, kanban_order_all,
# kanban_order_pinned and kanban_order_today — written by the app, not
# hand-edited, and separate from the manual_order_* keys above so a
# board drag never rearranges a hand-sorted list view.
kanban_view=0
# Kanban card drop shadow (1|0, default 1; Settings -> Appearance).  Lit
# from the upper left, so it falls to the bottom and right of each card.
# It is the one part of the board's look with a measurable price: GTK3
# blurs every shadow itself, on every draw, with no cache, so the blur
# costs about 1 ms per repaint of a lane's worth of visible cards.  Set
# this to 0 to get exactly the pre-shadow paint time back — the card's
# wrapper widget stays either way and is free.
kanban_shadow=1
# Manual task ordering (1|0, default 0; the toolbar sort-mode toggle or
# View → Manual Sort): shows a drag handle and lets rows be dragged.
# The order itself is stored per view in manual_order_list_<id>,
# manual_order_all, manual_order_pinned and manual_order_today — written
# by the app, not hand-edited.
task_list_manual_sort=0
# Task-pane column visibility (1|0; right-click a column header).  The
# Task column is always shown and has no key.  Status (New / In Progress
# / Done) defaults to HIDDEN: the ✓ column is the same field seen as a
# tick, and most rows need nothing more than that.
col_done_visible=1
col_status_visible=0
col_due_visible=1
col_completed_visible=1
# NOTE there is no db_integrity_check key any more (removed 2026-09-09).
# PRAGMA integrity_check + foreign_key_check run at EVERY launch, with the
# result in the status bar, and there is no way to switch that off: a
# health check that can be disabled reports silence meaning "not looked".
# A stale db_integrity_check in a live ini is inert.
# Rotating backups (Settings -> Database).  OFF by default.  With no
# backup_dir set they go to a backups/ folder inside the default database
# location (~/.local/share/tasks/backups), created on demand, so switching
# this on always does something.  Changing it is still worth it: the point
# is a copy somewhere INDEPENDENT of wherever the database itself lives,
# so one mishap cannot take both, and a subfolder of the database's own
# directory shares its fate exactly.  Each pass writes tasks-YYYYMMDD-HHMMSS.db
# there, verifies it, and only then prunes the oldest beyond backup_keep,
# so the folder is bounded and a failing backup can never erode the
# history already on disk.  A pass whose database has not changed since
# the last backup writes nothing at all.
backup_enabled=0
# backup_dir -- destination folder; per-machine, so it is not seeded here.
# Unset = ~/.local/share/tasks (the default database location).
# Minutes between passes (0 = only when "Back Up Now" is pressed).
backup_interval_min=60
# How many backup files to retain.
backup_keep=10
# db_dir — the directory holding tasks.db; absent = the default location
# under the user data dir, which is where it normally lives.  There is no
# Settings control for it: the key is written only by File -> Open
# Database File... choosing "Set as Default", and read once at startup.
# Per-machine, so it is not seeded here.
# win_w/win_h — the library window size, written on clean close and
# restored at launch (980x640 fallback); not meant for hand-editing.
