# Tasks — default settings, copied into the live tasks.ini on
# first launch.  The live ini is rewritten by the app and is gitignored.
#
# The group name below is part of the file format: the app reads only
# [tasks].
[tasks]
# Google Tasks sync — the OAuth client comes from Google's downloaded
# client_secret.apps.googleusercontent.com.json placed next to the app
# (gitignored — never commit it), or from a baked-in build default; the
# legacy google_client_id/google_client_secret keys here still override
# the baked-in client.  Signing in (once, in the browser) stores a
# sync-only refresh token here as gtasks_refresh_token.
# google_sync_enabled (1|0, default 1) is the master switch.


# Minutes between automatic syncs while signed in (0 disables the
# timer; the toolbar Sync button always works).
sync_interval_min=5
# Move the menu into the native macOS menu bar (1|0; needs a build with
# gtk-mac-integration-gtk3 — see Settings → Appearance).
native_menubar=0
# Render task titles in bold in the task list (1|0, default 0; Settings → Appearance).
bold_task_titles=0
# Show completed tasks in the task list (1|0, default 1; toolbar toggle).
show_completed=1
google_sync_enabled=1
# Show the Sync button in the toolbar (1|0; Settings → Google Tasks).
sync_toolbar_button=1
# Toolbar button rendering: icons|both|text (Settings → Appearance or
# right-click an empty toolbar spot).
toolbar_style=icons
# Notes integration: mirror its action items as ordinary tasks (1|0),
# and the notes CLI to reach them with (a path or a command name on
# PATH; Settings → Notes).  Needs a Notes new enough to understand
# `action list --uid` — the mirror keys tasks on that stable id and
# refuses to run against an older build rather than guess.
notes_sync=0
# notes_cli=notes
# notes_embed_list — a list id: file mirrored action items into that
# list; unset (or a list that no longer exists) uses the managed
# "Action Items" list, created on first use.
# How often the mirror runs, in minutes (0 = only when Sync is pressed).
# Local done/due changes are cached until then and pushed in bulk.
notes_sync_interval_min=5
# Show the sidebar's "Action Items" view — every mirrored item in one
# place, whichever list each one lives in (1|0; Settings → Notes).
notes_meta_row=1
# Sidebar visibility (1|0, default 0; the toolbar Sidebar toggle and
# View → Show Sidebar, which reads "Hide Sidebar" once it is up — every
# View item is named for the action a click performs).
sidebar_visible=0
# Compact controls (1|0, default 0; View → Compact Controls, which reads
# "Full Controls" while it is on): hides the top
# toolbar and floats New/Delete Task 20 px in from the bottom-right of
# the task area instead.  It leaves the sidebar alone — that stays under
# sidebar_visible above, in compact mode just the same.
compact_layout=0
# Show the Weekly Forecast view in the sidebar (1|0, default 1;
# Settings → Appearance).
weekly_forecast=1
# Let the Due Today view also list everything already past due
# (1|0, default 0; Settings → Appearance).
due_today_show_overdue=0
# Kanban View (1|0, default 0; View → Kanban View): show the selected
# view's tasks as a three-lane board (New / In Progress / Done) instead
# of a list, with cards you drag between lanes to change their status —
# and up and down within a lane to order them.  The Weekly Forecast keeps
# its own seven-day panel either way.  The card order is stored per view
# in kanban_order_list_<id>, kanban_order_all, kanban_order_pinned,
# kanban_order_today and kanban_order_bn_actions — written by the app,
# not hand-edited, and separate from the manual_order_* keys above so a
# board drag never rearranges a hand-sorted list view.
kanban_view=0
# Manual task ordering (1|0, default 0; the toolbar sort-mode toggle or
# View → Manual Sort): shows a drag handle and lets rows be dragged.
# The order itself is stored per view in manual_order_list_<id>,
# manual_order_all, manual_order_pinned, manual_order_today and
# manual_order_bn_actions — written by the app, not hand-edited.
task_list_manual_sort=0
# Task-pane column visibility (1|0; right-click a column header).  The
# Task column is always shown and has no key.  Status (New / In Progress
# / Done) defaults to HIDDEN: the ✓ column is the same field seen as a
# tick, and most rows need nothing more than that.
col_done_visible=1
col_status_visible=0
col_due_visible=1
col_completed_visible=1
# Run PRAGMA integrity_check + foreign_key_check on the database at
# startup (1|0, default 1); the result lands in the status bar.
db_integrity_check=1
# Rotating backups (Settings -> Database).  OFF by default.  With no
# backup_dir set they go to the DEFAULT DATABASE LOCATION under the home
# directory (~/.local/share/tasks), so switching this on always does
# something.  Choosing a folder is still worth it: the point is a copy
# somewhere INDEPENDENT of wherever the database itself lives, so one
# mishap cannot take both.  Each pass writes tasks-YYYYMMDD-HHMMSS.db
# there, verifies it, and only then prunes the oldest beyond backup_keep,
# so the folder is bounded and a failing backup can never erode the
# history already on disk.  A pass whose database has not changed since
# the last backup writes nothing at all.
backup_enabled=0
# backup_dir -- destination folder; per-machine, so it is not seeded here.
# Unset = ~/.local/share/tasks (the default database location).
# Minutes between passes (0 = only when "Back Up Now" is pressed).
backup_interval_min=60
# How many backup files to retain.
backup_keep=10
# db_dir — a custom directory holding tasks.db (Settings → Database);
# absent = the default location under the user data dir.  Per-machine,
# so it is not seeded here.
# win_w/win_h — the library window size, written on clean close and
# restored at launch (980x640 fallback); not meant for hand-editing.
